<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        method: Wähle je nach Ziel:
          "development"  – Testen auf Entwicklergeräten (persönlicher Test, einfachste Variante)
          "ad-hoc"       – Testen auf registrierten Geräten ohne App Store
          "app-store"    – Veröffentlichung im App Store / TestFlight
    -->
    <key>method</key>
    <string>development</string>

    <!-- Team ID aus Apple Developer Portal (10-stellig, z.B. AB12CD34EF) -->
    <!-- Wird im CI durch sed aus dem Secret IOS_TEAM_ID ersetzt -->
    <key>teamID</key>
    <string>APPLE_TEAM_ID_PLACEHOLDER</string>

    <key>signingStyle</key>
    <string>manual</string>

    <!--
        Provisioning Profile Name (exakt wie im Apple Developer Portal angelegt).
        Standard-Name laut Anleitung: "Grinffindor Development"
    -->
    <key>provisioningProfiles</key>
    <dict>
        <key>org.wiesche89.grinffindor</key>
        <string>Grinffindor Development</string>
    </dict>

    <key>stripSwiftSymbols</key>
    <true/>

    <key>compileBitcode</key>
    <false/>

    <key>thinning</key>
    <string>&lt;none&gt;</string>
</dict>
</plist>
